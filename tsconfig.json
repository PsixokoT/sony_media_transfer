{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "es2020",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "strict": true,
    "newLine": "LF",
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "outDir": "build"
  },
  "include": [
    "src"
  ]
}